# Copier en .env et adapter les valeurs.
# Host Traefik pour le routeur (sans https://)
# Le serveur MCP sera accessible sur mcp.<TRAEFIK_HOST> (ex: mcp.aifriendly.eu)
TRAEFIK_HOST=aifriendly.eu

# Optionnel : préfixe de l'image (registry)
# IMAGE_REGISTRY=registry.methodinfo.fr

# Base de données PostgreSQL
DB_CONNECTION_STRING=postgresql://user:password@host:5432/aifriendly

# Auth.js v5 — Authentification OAuth
# Générer avec: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://aifriendly.eu

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth — Personal accounts (https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID for the 10€/month subscription (create in Stripe Dashboard → Products)
STRIPE_PRICE_ID=

# ── vLLM / LLM worker (optional) ────────────────────────────────
# Base URL for OpenAI-compatible vLLM endpoint. Must include /v1 suffix.
# Leave empty to disable LLM and use heuristic-only scoring.
VLLM_API_URL=http://vllm-dev-service:8000/v1
VLLM_API_KEY=empty
# Doit correspondre a un --served-model-name de aifabric_vllm-dev-service,
# sinon chaque analyse echoue en 404 NotFoundError.
# Alias servis au 2026-09-11 : qwen3.8-flash-next, Qwen3.8-Flash-Next,
# Qwen3.6-27B-Prisma, Qwen3.6-27B (cf. AIFabric/devops/docker-compose.swarm.yml).
VLLM_MODEL=qwen3.8-flash-next