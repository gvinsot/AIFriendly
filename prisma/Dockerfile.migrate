# AI Friendly — Prisma Migration Runner
# Runs `prisma migrate deploy` then exits
# Used for Docker Swarm deployments
# Build context: racine du repo (nécessaire pour scripts/load-secrets.sh)

FROM node:24.22.1-alpine

WORKDIR /app

# Install Prisma CLI
RUN npm install -g prisma@6

# Copy Prisma schema and migrations
COPY prisma/schema.prisma ./prisma/schema.prisma
COPY prisma/migrations ./prisma/migrations

# Charge les secrets Docker (/run/secrets) dans l'environnement au démarrage
COPY scripts/load-secrets.sh /usr/local/bin/load-secrets.sh
RUN chmod +x /usr/local/bin/load-secrets.sh

WORKDIR /app/prisma

# Run migrations and exit
ENTRYPOINT ["/usr/local/bin/load-secrets.sh"]
CMD ["prisma", "migrate", "deploy"]
